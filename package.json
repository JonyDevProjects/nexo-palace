{
  "name": "@ijonydev/nexo-palace",
  "version": "0.1.3",
  "description": "Memoria de proyecto para agentes: índice híbrido (semántico + léxico) y grafo de trazabilidad, expuestos como CLI y servidor MCP.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "nexo-palace": "bin/nexo-palace.js",
    "nxpl": "bin/nexo-palace.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "nexo-palace.config.example.json",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "memory",
    "retrieval",
    "embeddings",
    "agents",
    "knowledge-graph"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test:unit && npm run build",
    "start": "node --experimental-strip-types src/cli.ts",
    "mcp": "node --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types src/test-mcp.ts",
    "test:unit": "vitest run",
    "bench": "node --experimental-strip-types src/bench.ts",
    "typecheck": "tsc --noEmit",
    "setup": "node --experimental-strip-types src/installer.ts || true",
    "postinstall": "node -e \"import('node:fs').then(fs => { if (fs.existsSync('dist/installer.js')) import('./dist/installer.js'); })\" || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.1.1",
    "sqlite-vec": "^0.1.9",
    "ts-morph": "^28.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  }
}
