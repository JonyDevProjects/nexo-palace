  "cards": [
    {
      "dot": "cyan",
      "title": "Desacoplamiento Estructural",
      "items": [
        "chunks_fts (BM25) y chunks_vec (k-NN) son tablas virtuales separadas",
        "Ambas apuntan a chunks.id pero no dependen entre sí",
        "Cambiar de proveedor de embeddings solo recrea chunks_vec sin tocar chunks_fts"
      ]
    },
    {
      "dot": "emerald",
      "title": "Grafo de Trazabilidad Integrado",
      "items": [
        "nodes almacena archivos, símbolos de código (AST), requisitos y tests",
        "edges vincula implements, tests, contains y depends_on",
        "Permite consultas transversales: Requisito -> Test -> Código -> Documento"
      ]
    }
  ]
